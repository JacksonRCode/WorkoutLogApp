{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "allowJs": true,
    "checkJs": false,
    "strict": true,

    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
